generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Department {
  id           String     @id @default(cuid())
  name         String
  passwordWord String
  // Live-rotation: "off", "schedule" (scheman med raster) eller "continuous" (byter hela tiden).
  liveMode              String  @default("off")
  rotationIntervalMin   Int     @default(20)
  // Blir ett pass kortare än så här (t.ex. efter en rast) hoppas nästa byte över.
  minPassMin            Int     @default(5)
  archived     Boolean    @default(false)
  archivedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  zones        Zone[]
  groups       Group[]
  people       Person[]
  rotations    Rotation[]
  adminLogs    AdminLog[]
  loginLocks   LoginLock[]
  schedules    WorkSchedule[]
}

model Zone {
  id           String      @id @default(cuid())
  name         String
  orderIndex   Int
  active       Boolean     @default(true)
  temporary    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignments  RotationAssignment[]

  @@unique([departmentId, orderIndex])
  @@index([departmentId, orderIndex])
  @@index([departmentId, active])
  @@index([departmentId, temporary])
}

model Group {
  id           String     @id @default(cuid())
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  people       Person[]
  rotations    Rotation[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

model Person {
  id           String     @id @default(cuid())
  name         String
  active       Boolean    @default(true)
  archived     Boolean    @default(false)
  archivedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  departmentId String
  groupId      String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Restrict)
  assignments  RotationAssignment[]

  @@index([departmentId, active])
  @@index([groupId, active])
  @@index([departmentId, archived])
}

model Rotation {
  id           String               @id @default(cuid())
  createdAt    DateTime             @default(now())
  score        Int
  // Ögonblicksbild (JSON) av tider och raster som gällde när rotationen skapades.
  liveSchedule String?
  departmentId String
  groupId      String
  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  group        Group                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  assignments  RotationAssignment[]

  @@index([departmentId, groupId, createdAt(sort: Desc)])
}

model RotationAssignment {
  id         String   @id @default(cuid())
  rotationId String
  zoneId     String
  personId   String
  zoneIndex  Int
  rotation   Rotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  zone       Zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  person     Person   @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([rotationId, zoneId])
  @@unique([rotationId, personId])
  @@index([rotationId, zoneIndex])
  @@index([zoneId])
  @@index([personId])
}

model AdminLog {
  id           String      @id @default(cuid())
  eventType    String
  message      String
  metadata     String?
  createdAt    DateTime    @default(now())
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([departmentId, createdAt(sort: Desc)])
}

// Misslyckade inloggningar räknas per avdelning (eller siteadmin) och IP-adress,
// så att en utomstående inte kan låsa ute en hel avdelning.
model LoginLock {
  id                String      @id @default(cuid())
  scope             String      // "department:<id>" eller "site-admin"
  ip                String
  failures          Int         @default(0)
  lockedUntil       DateTime?
  permanentlyLocked Boolean     @default(false)
  lastFailureAt     DateTime    @default(now())
  createdAt         DateTime    @default(now())
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([scope, ip])
  @@index([departmentId])
}

// Arbetstidsschema, t.ex. Förmiddag 06:00–14:30. Tider i minuter efter midnatt
// (svensk tid). Slutar schemat före starttiden går det över midnatt (natt).
model WorkSchedule {
  id           String          @id @default(cuid())
  name         String
  startMinute  Int
  endMinute    Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  breaks       ScheduleBreak[]

  @@index([departmentId])
}

// Rast där hela skiftet stannar, t.ex. Lunch 10:00 i 30 minuter.
model ScheduleBreak {
  id              String       @id @default(cuid())
  label           String
  startMinute     Int
  durationMinutes Int
  scheduleId      String
  schedule        WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}
